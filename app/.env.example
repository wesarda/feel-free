# Copy to .env.local for `npm run dev`, or set the same names in Vercel → Settings → Environment Variables.

# AI moderation of comments and photos (Claude). Without it nothing new is published: content waits as "pending".
ANTHROPIC_API_KEY=
# Optional: another Claude model for moderation (the default is set in api/_lib/moderation.ts).
MODERATION_MODEL=

# Storage for comments and photos (Upstash Redis REST API, the same as in vortex_space).
# Locally, without these, the dev server keeps data in app/.data/community.json.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
